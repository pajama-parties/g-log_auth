# ── 앱 ──
PORT=3000

# ── PostgreSQL (docker compose 가 이 값으로 컨테이너를 만듭니다) ──
# 이 PC에서 5432를 이미 쓰고 있을 수 있어서 도커 PostgreSQL은 5433으로 엽니다.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=glog
DB_PASSWORD=change-me

# DB 하나에 스키마 두 개 (auth: 계정·토큰 / service: 화분·커뮤니티 등)
DB_NAME=glog

# SQL 로그 출력 (true / false)
DB_LOGGING=false

# ── 카카오 로그인 (developers.kakao.com → 내 애플리케이션) ──
KAKAO_CLIENT_ID=REST_API_키
# 보안 → Client Secret을 "사용함"으로 했다면 값 입력, 아니면 비워 둠
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback
# 카카오 JavaScript SDK 키 (내 애플리케이션 > 앱 키 > JavaScript 키). 플랫폼 > Web 에 http://localhost:3000 등록 필요
KAKAO_JAVASCRIPT_KEY=

# ── JWT ── access 토큰 서명 키(32바이트 이상): node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# refresh 토큰은 랜덤 문자열을 DB에 해시로 저장하므로 키가 필요 없음
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d

# ── 메일 (이메일 코드 로그인) ──
# 비워 두면 메일을 보내지 않고 서버 로그에 인증 코드를 출력 (개발용, 운영에서는 시작 실패)
# Gmail: 구글 계정 2단계 인증 → https://myaccount.google.com/apppasswords 에서 앱 비밀번호(16자리) 발급
SMTP_USER=
SMTP_PASS=
# 기본 smtp.gmail.com / 465. 다른 SMTP 서버일 때만
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# 보내는 사람 표시. 비우면 "g-log <SMTP_USER>" (Gmail은 SMTP_USER 주소로만 보낼 수 있음)
# MAIL_FROM=g-log <your@gmail.com>

# 로그인·가입 횟수 제한 (같은 IP, 1분당). 비우면 10
# SIGN_IN_RATE_LIMIT=10

# nginx 등 프록시 뒤에서 실행할 때만. 실제 클라이언트 IP를 X-Forwarded-For에서 읽음 (docker-compose.yml의 auth 서비스는 자동 설정)
# TRUST_PROXY=loopback, uniquelocal
